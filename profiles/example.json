{
  "version": 1,
  "name": "Example remote profile — configure before publishing",
  "example": true,
  "baseUrl": "https://bifrost.example.invalid",
  "authUrl": "https://bifrost.example.invalid/keys",
  "codex": {
    "models": [
      {
        "default_reasoning_level": "medium",
        "supported_reasoning_levels": [
          {
            "effort": "low",
            "description": "Fast"
          },
          {
            "effort": "medium",
            "description": "Balanced"
          },
          {
            "effort": "high",
            "description": "Thorough"
          }
        ],
        "shell_type": "unified_exec",
        "include_skills_usage_instructions": true,
        "include_plugin_usage_instructions": true,
        "include_apps_usage_instructions": false,
        "support_verbosity": false,
        "default_verbosity": null,
        "apply_patch_tool_type": "freeform",
        "web_search_tool_type": "text",
        "truncation_policy": {
          "mode": "tokens",
          "limit": 10000
        },
        "supports_image_detail_original": false,
        "context_window": 128000,
        "effective_context_window_percent": 95,
        "input_modalities": [
          "text"
        ],
        "experimental_supported_tools": [],
        "supports_search_tool": false,
        "supports_reasoning_summaries": false,
        "base_instructions": "You are a coding assistant. Work with the user to complete software engineering tasks.",
        "slug": "openai/your-codex-model",
        "display_name": "Your Codex model",
        "description": "Replace ID and capabilities with your gateway model's actual values",
        "visibility": "list",
        "supported_in_api": true,
        "priority": 0
      }
    ],
    "model": "openai/your-codex-model"
  },
  "claude": {
    "model": "anthropic/your-claude-model",
    "modelPicker": {
      "replaceBuiltInOptions": true,
      "options": [
        {
          "model": "anthropic/your-claude-model",
          "label": "Your Claude model",
          "description": "Replace with a tool-capable model configured in Bifrost"
        }
      ]
    }
  }
}
